# Python environments, builds, and caches
__pycache__/
*.py[oc]
.venv/
venv/
env/
build/
dist/
wheels/
*.egg-info/
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/
.coverage*
htmlcov/
.ipynb_checkpoints/

# Local financial data and generated analysis stay off Git by default
/data/
/results/
/private/
/secrets/
/configs/*.local.*
/configs/private/
*.parquet
*.feather
*.arrow
*.sqlite*
*.db

# Environment files, credentials, and private keys
.env
.env.*
.envrc
.netrc
_netrc
.npmrc
.pypirc
.aws/
.azure/
.kube/
.ssh/
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519
*credentials*.json
*service-account*.json
client_secret*.json

# Editor settings, agent state, and private Site configuration
.vscode/
.idea/
*.code-workspace
.codex/
.agents/
.openai/
.sites-checkout*/
.sites-runtime/
node_modules/
dashboard/.git/

# Keep dashboard source; ignore exported data and other build artifacts
!dashboard/dist/
dashboard/dist/*
!dashboard/dist/index.html
!dashboard/dist/styles.css
!dashboard/dist/app.js

# Logs, backups, and operating-system files
*.log
*.bak
*.backup
*.swp
*.swo
*~
.DS_Store
Thumbs.db
